{
  "dataset": "CloudSEN12_L1C",
  "model": "FMamba_CAFBR",
  "data_root": "/opt/data/private/Dataset/Cloud-Adapter/cloudsen12_high_l1c",
  "work_dir": "experiments/CloudSEN12_L1C/FMamba_CAFBR",
  "classes": [
    "clear",
    "thick cloud",
    "thin cloud",
    "cloud shadow"
  ],
  "image_size": [
    512,
    512
  ],
  "mean": [
    123.675,
    116.28,
    103.53
  ],
  "std": [
    58.395,
    57.12,
    57.375
  ],
  "base_channels": 64,
  "batch_size": 1,
  "num_workers": 4,
  "max_iters": 40000,
  "cafbr_start_ratio": 0.5,
  "val_interval": 2000,
  "log_interval": 50,
  "lr": 0.0001,
  "weight_decay": 0.05,
  "poly_power": 0.9,
  "seed": 42,
  "device": "cuda",
  "amp": false,
  "keep_top_k": 3,
  "selection_metric": "mIoU",
  "ignore_index": 255,
  "loss": {
    "ce_weight": 5.0,
    "dice_weight": 5.0,
    "dice_eps": 1e-05
  },
  "fmamba": {
    "scgm_num_groups": 3,
    "skip_refinement": {
      "enabled": true,
      "type": "cloud_adaptive_frequency_boundary",
      "reduction": 8,
      "spatial_kernel": 7,
      "detail_kernel": 3,
      "gate_bias": 0.0,
      "gate_scale_init": 1.0,
      "detail_scale_init": 0.1,
      "context_scale_init": 0.05,
      "spectral_scale_init": 0.05,
      "use_fourier": true,
      "fourier_stages": [
        "stage_4",
        "stage_3",
        "stage_2"
      ],
      "spectral_reduction": 4
    }
  },
  "validation_split": "test",
  "test_split": "test",
  "smoke_val_limit": 8,
  "smoke_test_limit": 8,
  "train_loss_only": true,
  "lr_schedule": "cosine",
  "warmup_ratio": 0.1,
  "warmup_start_factor": 0.01,
  "min_lr_ratio": 0.0,
  "grad_accum_steps": 2,
  "effective_batch_size": 4,
  "world_size": 2
}
